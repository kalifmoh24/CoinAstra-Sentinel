# CoinAstra Sentinel — environment variables
# Copy to .env and fill in as needed. Never commit real secrets.

DEMO_MODE=false

ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
ETH_RPC_URL=
OPENAI_API_KEY=

# PostgreSQL required (Neon, Docker, or managed Postgres).
# Example Neon: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Example Docker: postgresql://postgres:postgres@localhost:5432/coinastra_sentinel
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coinastra_sentinel"

NEXT_PUBLIC_APP_URL=http://localhost:3000
