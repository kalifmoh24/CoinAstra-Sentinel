// CoinAstra Sentinel — Prisma schema (PostgreSQL)
// Local/dev: Neon free tier or Docker Postgres. DEMO_MODE fixtures still power scans.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scan {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  input       String
  inputType   String
  chain       String   @default("ethereum")
  demo        Boolean  @default(false)
  score       Int
  band        String
  summaryJson String
  resultJson  String
  clientIp    String?
  userAgent   String?
}

model RateLimitBucket {
  id        String   @id @default(cuid())
  key       String
  day       String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([key, day])
}
