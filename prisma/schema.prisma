// CoinAstra Sentinel — Prisma schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scan {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  input       String
  inputType   String
  chain       String   @default("ethereum")
  demo        Boolean  @default(false)
  score       Int
  band        String
  summaryJson String
  resultJson  String
  clientIp    String?
  userAgent   String?
  ownerKey    String?

  @@index([createdAt])
  @@index([ownerKey])
  @@index([input, inputType])
}

model RateLimitBucket {
  id        String   @id @default(cuid())
  key       String
  day       String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([key, day])
}

model WatchItem {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ownerKey    String
  subject     String
  subjectType String
  chain       String   @default("ethereum")
  label       String?
  lastScore   Int?
  lastBand    String?
  lastScanId  String?
  note        String?

  @@unique([ownerKey, subject, subjectType, chain])
  @@index([ownerKey])
}

model AlertEvent {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  ownerKey       String?
  scanId         String?
  subject        String
  subjectType    String
  severity       String
  title          String
  description    String
  evidence       String
  recommendation String?
  href           String

  @@index([createdAt])
  @@index([ownerKey])
}
